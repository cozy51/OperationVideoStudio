{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Operation Video Studio",
  "version": "0.1.0",
  "identifier": "jp.operationvideostudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Operation Video Studio",
        "width": 1440,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 740
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Windows操作録画・動画編集",
    "windows": {
      "nsis": { "languages": ["Japanese"], "displayLanguageSelector": false },
      "wix": { "language": "ja-JP" }
    }
  }
}
